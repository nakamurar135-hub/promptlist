# ============================================================
# promptlist - 環境変数サンプル（.env.example）
# ============================================================
# このファイルをコピーして .env を作成してください:
#   cp .env.example .env
#
# ⚠️  Manus webdevで動かす場合、以下の「Manusが自動設定」の変数は
#     Manusのダッシュボードから自動注入されます。
#     ローカル開発時のみ手動で設定してください。

# ── Manus OAuth / 認証（Manusが自動設定） ────────────────────────
VITE_APP_ID=proj_abc123def456
OAUTH_SERVER_URL=https://vidabiz.butterfly-effect.dev
VITE_OAUTH_PORTAL_URL=https://vida.butterfly-effect.dev

# ── データベース（Manusが自動設定） ──────────────────────────────
DATABASE_URL=mysql://example-user:example-password@localhost:3306/main

# ── セッション署名シークレット（Manusが自動設定） ─────────────────
JWT_SECRET=your-jwt-secret-change-in-production

# ── オーナー情報（Manusが自動設定） ──────────────────────────────
OWNER_OPEN_ID=your-open-id

# ── Manus Built-in API（Manusが自動設定） ────────────────────────
BUILT_IN_FORGE_API_URL=https://api.manus.im/api/forge
BUILT_IN_FORGE_API_KEY=your-forge-api-key
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://api.manus.im/api/forge

# ── アナリティクス（任意） ────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=https://umami.dev.ops.butterfly-effect.dev
VITE_ANALYTICS_WEBSITE_ID=analytics_proj_abc123def456

# ── サーバー設定 ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Stripe（★ユーザーが自分で取得・設定が必要） ─────────────────
# Stripeダッシュボード → APIキー から取得
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripeダッシュボード → Webhook → 署名シークレット から取得
# ローカル開発時は: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripeダッシュボード → 商品カタログ → 価格ID から取得（月額¥500）
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
